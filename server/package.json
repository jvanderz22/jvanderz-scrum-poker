{
  "name": "scrum-poker-server",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal scrum poker backend: room creation + realtime estimates over websocket",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
